# Copy to .env or pass these through your shell or container.

APP_NAME=API & Webhook Reliability Monitor
DATABASE_URL=sqlite:///./data/monitor.db

# How often the retry worker looks for deliveries that are due, in seconds.
RETRY_POLL_SECONDS=5

# Timeout for forwarded requests and for the API tester, in seconds.
REQUEST_TIMEOUT_SECONDS=15

# Webhook bodies larger than this are rejected with HTTP 413.
MAX_BODY_BYTES=1000000

# run.py only: address, port and auto-reload for the development server.
HOST=127.0.0.1
PORT=8000
RELOAD=1
